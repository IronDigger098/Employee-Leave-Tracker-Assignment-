# Copy this file to `.env` and adjust if you want to override the defaults.
#   cp .env.example .env
#
# `.env` is git-ignored. This file contains PLACEHOLDERS ONLY - no real secrets.
# docker-compose.yml also carries safe defaults, so the project runs with
# `docker compose up --build` even if you never create a .env file.

# ---- PostgreSQL ----
POSTGRES_DB=leave_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Backend ----
# Must be at least 32 characters - HS256 requires a 256-bit signing key.
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ---- Leave policy ----
# Leave days each employee may take per calendar year.
# Approved and pending requests both count against it.
LEAVE_ANNUAL_ENTITLEMENT_DAYS=27
